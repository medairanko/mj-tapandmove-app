{
  "expo": {
    "name": "MJ tap&move",
    "slug": "mj-tapandmove-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1420",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "kr.co.mjsmart.tapandmove",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2ECC9A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0d1420"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f4bacf30-5989-431e-8c0b-2f866d97547b"
      }
    },
    "owner": "persianmeda"
  }
}
